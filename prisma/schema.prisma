datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// PERMANENT ENTITIES
// ==========================================

model SchoolProfile {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactInfo  String?
  address      String?
  email        String? // Admin root email
  phone        String? // Admin root phone
  passwordHash String? // Admin root password
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  campuses     Campus[]
  roles        Role[]

  @@map("school_profile")
}

model Campus {
  id                   String                @id @default(uuid()) @db.Uuid
  schoolProfileId      String                @db.Uuid
  schoolProfile        SchoolProfile         @relation(fields: [schoolProfileId], references: [id], onDelete: Cascade)
  name                 String                @unique
  address              String
  capacity             Int
  status               String                @default("Active")
  latitude             Float?
  longitude            Float?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            String?
  updatedBy            String?
  classes              Class[]
  assets               Asset[]
  rooms                Room[]
  purchaseRequisitions PurchaseRequisition[]
  enrollments          StudentEnrollment[]

  attendanceRecords AttendanceRecord[]
  feeInvoices       FeeInvoice[]
  acmsHolidays      ACMSHolidayMaster[]
  morningAssemblies MorningAssembly[]
  acmsEvents        ACMSEvent[]

  @@map("campuses")
}

model Role {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @unique
  description     String?
  permissions     String[]
  status          String         @default("Active") // Active, Inactive
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  updatedBy       String?
  staff           Staff[]
  schoolProfileId String?        @db.Uuid
  schoolProfile   SchoolProfile? @relation(fields: [schoolProfileId], references: [id], onDelete: Cascade)

  @@map("roles")
}

model Staff {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String
  fullName     String
  roleId       String              @db.Uuid
  role         Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status       String              @default("Active") // Active, Inactive, Suspended
  gender       String?
  education    String?
  experience   String?
  photoUrl     String?
  details      Json?               @db.JsonB
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?
  updatedBy    String?
  assignments  TeacherAssignment[]
  attendance   AttendanceRecord[]

  // HR & Payroll Relations
  leaveBalances         LeaveBalance[]
  leaveApplications     LeaveApplication[]
  resolvedLeaves        LeaveApplication[]        @relation("ResolvedLeaves")
  resolvedStudentLeaves StudentLeaveApplication[] @relation("ResolvedStudentLeaves")
  payrollStructure      PayrollStructure?
  transportAssignments  TransportVehicleStaff[]
  payslips              Payslip[]
  performanceReviews    PerformanceReview[]       @relation("StaffReviews")
  givenReviews          PerformanceReview[]       @relation("ReviewerStaff")
  TransportTrip         TransportTrip[]
  TransportBreakdown    TransportBreakdown[]
  TransportAccident     TransportAccident[]
  TransportDailyCheck   TransportDailyCheck[]
  LMSCourseSection      LMSCourseSection[]
  LMSLiveClass          LMSLiveClass[]
  EMSInvigilator        EMSInvigilator[]
  EMSEvaluationRecord   EMSEvaluationRecord[]
  EMSModerationRecord   EMSModerationRecord[]
  IdCards               IdCard[]
  homeworkAssignments   LMSAssignment[]
  hostelOutpassesApproved HostelOutpass[]
  vehicleGateLogsLogged   VehicleGateLog[]
  studentGateLogsLogged   StudentGateLog[]
  courierLogsLogged       CourierLog[]
  appointmentsHosted      Appointment[]
  meetingsOrganized       Meeting[]

  healthVisitsLogged        HealthVisit[]
  disciplineIncidentsFiled  DisciplineIncident[]       @relation("DisciplineReportedBy")
  disciplineCounselingNotes DisciplineCounselingNote[]
  assignedInquiries         AdmissionInquiry[]
  inquiryFollowUps          AdmissionInquiryFollowUp[]

  comments    Comment[]
  attachments Attachment[]

  visitorRecords        VisitorRecord[]
  approvedGatePasses    StudentGatePass[]
  housesManaged         SchoolHouse[]
  duties                StaffDutyAllocation[]
  primarySubstitutions  TeacherSubstitution[] @relation("PrimaryTeacher")
  substituteAssignments TeacherSubstitution[] @relation("SubstituteTeacher")
  writtenDiaryEntries   SchoolDiaryEntry[]
  assignedGrievances    GrievanceRecord[]
  lostFoundItems        LostFoundItem[]
  supervisedAssemblies  MorningAssembly[]
  issuedAchievements    StudentAchievement[]  @relation("IssuedBy")

  @@map("staff")
}

model Student {
  id                  String               @id @default(uuid()) @db.Uuid
  admissionNumber     String               @unique
  fullName            String
  gender              String
  guardianName        String
  phone               String
  status              String               @default("Active")
  documentsVerified   Boolean              @default(false)
  dateOfBirth         DateTime?
  photoUrl            String?
  profilePicture      String?
  faceEmbedding       Json?                @db.JsonB
  passwordHash        String?
  documentDetails     Json?                @db.JsonB
  details             Json?                @db.JsonB
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           String?
  updatedBy           String?
  enrollments         StudentEnrollment[]
  parents             ParentStudent[]
  documents           AdmissionDocument[]
  LMSSubmission       LMSSubmission[]
  LMSQuizAttempt      LMSQuizAttempt[]
  LMSGrade            LMSGrade[]
  LMSStudentPortfolio LMSStudentPortfolio?
  EMSExamSeating      EMSExamSeating[]
  EMSExamAttempt      EMSExamAttempt[]
  EMSResult           EMSResult[]
  EMSReportCard       EMSReportCard[]
  EMSCertificate      EMSCertificate[]
  IdCards             IdCard[]

  healthProfile       HealthProfile?
  healthVisits        HealthVisit[]
  vaccinations        Vaccination[]
  disciplineIncidents DisciplineIncident[]
  admissionInquiry    AdmissionInquiry?

  gatePasses          StudentGatePass[]
  housesCaptained     SchoolHouse[]        @relation("HouseCaptain")
  housesViceCaptained SchoolHouse[]        @relation("HouseViceCaptain")
  diaryEntries        SchoolDiaryEntry[]
  achievements        StudentAchievement[]

  houseId String?      @db.Uuid
  house   SchoolHouse? @relation("HouseMembers", fields: [houseId], references: [id])

  @@map("students")
}

// ==========================================
// ACADEMIC SESSION & HIERARCHY
// ==========================================

model AcademicSession {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @unique // e.g. "2026-2027"
  isActive          Boolean             @default(false)
  status            String              @default("Active")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  updatedBy         String?
  classes           Class[]
  enrollments       StudentEnrollment[]
  assignments       TeacherAssignment[]
  timetables        Timetable[]
  slots             TimetableSlot[]
  feeStructures     FeeStructure[]
  exams             Exam[]
  acmsTerms         ACMSAcademicTerm[]
  acmsWorkingDays   ACMSWorkingDay[]
  acmsEvents        ACMSEvent[]
  attendanceRecords AttendanceRecord[]

  @@map("academic_sessions")
}

model Class {
  id            String          @id @default(uuid()) @db.Uuid
  grade         String // e.g. "Grade 10"
  campusId      String          @db.Uuid
  campus        Campus          @relation(fields: [campusId], references: [id], onDelete: Restrict)
  sessionId     String          @db.Uuid
  session       AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  status        String          @default("Active")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     String?
  updatedBy     String?
  sections      Section[]
  subjects      ClassSubject[]
  feeStructures FeeStructure[]
  examSlots     ExamSlot[]
  LMSCourse     LMSCourse[]
  EMSGradebook  EMSGradebook[]

  @@map("classes")
}

model Section {
  id                String              @id @default(uuid()) @db.Uuid
  name              String // e.g. "Section A"
  classId           String              @db.Uuid
  class             Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  status            String              @default("Active")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  updatedBy         String?
  enrollments       StudentEnrollment[]
  assignments       TeacherAssignment[]
  timetable         TimetablePeriod[]
  LMSCourseSection  LMSCourseSection[]
  morningAssemblies MorningAssembly[]
  homeworkAssignments LMSAssignment[]

  @@map("sections")
}

model Subject {
  id               String              @id @default(uuid()) @db.Uuid
  name             String
  classes          ClassSubject[]
  medium           String // e.g. "English", "French"
  status           String              @default("Active")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String?
  updatedBy        String?
  allocations      TeacherAssignment[]
  timetable        TimetablePeriod[]
  examSlots        ExamSlot[]
  LMSCourse        LMSCourse[]
  LMSQuestionBank  LMSQuestionBank[]
  EMSExamSchedule  EMSExamSchedule[]
  EMSQuestionBank  EMSQuestionBank[]
  EMSQuestionPaper EMSQuestionPaper[]

  @@map("subjects")
}

// ==========================================
// SESSION-BASED RELATIONSHIPS
// ==========================================

model StudentEnrollment {
  id          String             @id @default(uuid()) @db.Uuid
  studentId   String             @db.Uuid
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId   String             @db.Uuid
  session     AcademicSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionId   String             @db.Uuid
  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  rollNumber  String?
  status      String             @default("Enrolled") // Enrolled, Promoted, Archived
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   String?
  updatedBy   String?
  attendance  AttendanceRecord[]
  reportCards ReportCard[]
  invoices    FeeInvoice[]
  examMarks   ExamMarks[]

  transportAssignments TransportStudentAssignment[]
  hostelAllocations    HostelAllocation[]
  hostelAttendance     HostelAttendance[]
  hostelGrievances     HostelGrievance[]
  bookIssues           BookIssue[]
  libraryReservations  LibraryReservation[]

  campusId                 String?                   @db.Uuid
  campus                   Campus?                   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  TransportAttendance      TransportAttendance[]
  studentLeaveApplications StudentLeaveApplication[]
  hostelOutpasses          HostelOutpass[]
  gateLogs                 StudentGateLog[]

  @@index([sectionId, sessionId])
  @@index([campusId, sectionId, sessionId])
  @@map("student_enrollments")
}

model TeacherAssignment {
  id             String            @id @default(uuid()) @db.Uuid
  staffId        String            @db.Uuid
  staff          Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  sessionId      String            @db.Uuid
  session        AcademicSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectId      String?           @db.Uuid
  subject        Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sectionId      String?           @db.Uuid
  section        Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  roomId         String?           @db.Uuid
  room           Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  isClassTeacher Boolean           @default(false)
  hoursPerWeek   Float?
  status         String            @default("Active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?
  timetable      TimetablePeriod[]

  @@index([staffId, sessionId])
  @@map("teacher_assignments")
}

// ==========================================
// TRANSACTIONAL DATA (TIED TO ENROLLMENT/ASSIGNMENT)
// ==========================================

model AttendanceRecord {
  id           String             @id @default(uuid()) @db.Uuid
  enrollmentId String?            @db.Uuid
  enrollment   StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  staffId      String?            @db.Uuid
  staff        Staff?             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD
  status       String // Present, Absent, Late, Leave
  checkInTime  String?
  checkOutTime String?
  faceVerified Boolean            @default(false)
  location     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  updatedBy    String?

  campusId String? @db.Uuid
  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  sessionId String?          @db.Uuid
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, date])
  @@index([campusId, date])
  @@index([sessionId, date])
  @@map("attendance_records")
}

// ==========================================
// LMS (PHASE 7)
// ==========================================

model ReportCard {
  id             String            @id @default(uuid()) @db.Uuid
  enrollmentId   String            @db.Uuid
  enrollment     StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  examId         String?           @db.Uuid
  exam           Exam?             @relation(fields: [examId], references: [id], onDelete: SetNull)
  attendanceRate String
  gpa            String
  computedData   Json?             @db.JsonB
  remarks        String?
  isApproved     Boolean           @default(false)
  status         String            @default("Active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?

  @@map("report_cards")
}

// ==========================================
// EXAMS & GRADING
// ==========================================

model Exam {
  id          String          @id @default(uuid()) @db.Uuid
  name        String // e.g. "Mid-Term 2026"
  term        String?
  sessionId   String          @db.Uuid
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      String          @default("Scheduled") // Scheduled, Ongoing, Completed
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?
  updatedBy   String?
  slots       ExamSlot[]
  reportCards ReportCard[]

  @@map("exams")
}

model ExamSlot {
  id        String      @id @default(uuid()) @db.Uuid
  examId    String      @db.Uuid
  exam      Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String      @db.Uuid
  class     Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String      @db.Uuid
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  startTime String // HH:MM
  endTime   String // HH:MM
  room      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  createdBy String?
  updatedBy String?
  marks     ExamMarks[]

  @@map("exam_slots")
}

model ExamMarks {
  id            String            @id @default(uuid()) @db.Uuid
  examSlotId    String            @db.Uuid
  examSlot      ExamSlot          @relation(fields: [examSlotId], references: [id], onDelete: Cascade)
  enrollmentId  String            @db.Uuid
  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  marksObtained Float?
  isAbsent      Boolean           @default(false)
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     String?
  updatedBy     String?

  @@map("exam_marks")
}

model GradingRule {
  id        String   @id @default(uuid()) @db.Uuid
  name      String // e.g. "Standard Absolute Scale"
  rules     Json     @db.JsonB // Stores the scale e.g. [{"min": 90, "grade": "A+"}, ...]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("grading_rules")
}

// ==========================================
// PORTAL & USERS (PHASE 5)
// ==========================================

model Parent {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  phone        String?
  email        String?         @unique
  passwordHash String?
  status       String          @default("Active")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  students     ParentStudent[]

  @@map("parents")
}

model ParentStudent {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String   @db.Uuid
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String   @db.Uuid
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String   @default("Parent") // e.g. Father, Mother, Guardian
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model PortalAccount {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique // email or admissionNumber
  passwordHash String
  userType     String // "STUDENT" | "PARENT"
  referenceId  String   @db.Uuid // UUID of Student or Parent
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portal_accounts")
}

// ==========================================
// COMMUNICATION (PHASE 6)
// ==========================================

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @db.Uuid // Links to PortalAccount
  type        String // "SMS" | "EMAIL" | "PUSH"
  title       String?
  content     String
  priority    String   @default("NORMAL") // "URGENT" | "NORMAL" | "LOW"
  readStatus  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model Announcement {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  body           String
  targetAudience String    @default("ALL") // "ALL" | "PARENTS" | "STUDENTS" | "STAFF"
  eventDate      DateTime?
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?

  @@map("announcements")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  parentId  String    @db.Uuid
  staffId   String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([parentId, staffId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid // UUID of the sender (Parent or Staff)
  senderType     String // "PARENT" | "STAFF"
  content        String
  readStatus     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Timetable {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  sessionId String            @db.Uuid
  session   AcademicSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status    String            @default("Draft") // Draft, Active, Archived
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  periods   TimetablePeriod[]

  @@map("timetables")
}

model TimetableSlot {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  startTime String
  endTime   String
  isBreak   Boolean         @default(false)
  sessionId String          @db.Uuid
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy String?
  updatedBy String?

  @@map("timetable_slots")
}

model TimetablePeriod {
  id            String                @id @default(uuid()) @db.Uuid
  timetableId   String                @db.Uuid
  timetable     Timetable             @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  sectionId     String                @db.Uuid
  section       Section               @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId     String?               @db.Uuid
  subject       Subject?              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignmentId  String                @db.Uuid
  assignment    TeacherAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  dayOfWeek     String // Monday, Tuesday, etc.
  startTime     String // HH:MM
  endTime       String // HH:MM
  room          String
  status        String                @default("Active")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdBy     String?
  updatedBy     String?
  substitutions TeacherSubstitution[]

  @@map("timetable_periods")
}

// ==========================================
// PHASE 8: OPERATIONAL MODULES
// ==========================================

// --- TRANSPORT (Replaced at bottom of schema) ---

// --- HOSTEL & MESS ---
model Hostel {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  type       String // "BOYS" | "GIRLS" | "COED"
  warden     String?
  status     String            @default("Active")
  rooms      HostelRoom[]
  grievances HostelGrievance[]
  menus      MessMenu[]

  @@map("hostels")
}

model HostelRoom {
  id          String             @id @default(uuid()) @db.Uuid
  hostelId    String             @db.Uuid
  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  roomNumber  String
  capacity    Int
  status      String             @default("Active")
  allocations HostelAllocation[]

  @@map("hostel_rooms")
}

model HostelAllocation {
  id           String            @id @default(uuid()) @db.Uuid
  roomId       String            @db.Uuid
  room         HostelRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  enrollmentId String            @db.Uuid
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       String            @default("Active")
  createdAt    DateTime          @default(now())

  @@map("hostel_allocations")
}

model HostelAttendance {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @db.Uuid
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD
  status       String // Present, Absent, Leave
  createdAt    DateTime          @default(now())

  @@map("hostel_attendance")
}

model HostelGrievance {
  id           String            @id @default(uuid()) @db.Uuid
  hostelId     String            @db.Uuid
  hostel       Hostel            @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  enrollmentId String            @db.Uuid
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String
  description  String
  status       String            @default("Open") // Open, Resolved
  createdAt    DateTime          @default(now())

  @@map("hostel_grievances")
}

model MessMenu {
  id        String   @id @default(uuid()) @db.Uuid
  hostelId  String   @db.Uuid
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  dayOfWeek String
  mealType  String // Breakfast, Lunch, Dinner
  items     String
  createdAt DateTime @default(now())

  @@map("mess_menus")
}

// Added Phase 2 — campus gate vehicle log (SOR item 2.4). Separate from
// TransportVehicle/TransportTrip, which track the school's own bus fleet —
// this logs any vehicle (staff, delivery, visitor) entering/exiting the gate.
model VehicleGateLog {
  id            String    @id @default(uuid()) @db.Uuid
  vehicleNumber String
  driverName    String?
  purpose       String
  entryTime     DateTime  @default(now())
  exitTime      DateTime?
  loggedById    String?   @db.Uuid
  loggedBy      Staff?    @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@map("vehicle_gate_logs")
}

// Added Phase 2 — student late-entry/early-exit gate log (SOR item 2.5).
model StudentGateLog {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @db.Uuid
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type         String // LATE_ENTRY, EARLY_EXIT
  reason       String?
  timestamp    DateTime          @default(now())
  loggedById   String?           @db.Uuid
  loggedBy     Staff?            @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@map("student_gate_logs")
}

// Added Phase 2 — real outpass workflow (request -> approve/reject -> exit ->
// return), replacing the same-day attendance-status workaround the SOR audit
// found ("Leave" was just one of three roll-call buttons, not an approvable
// request with dates/reason/duration).
model HostelOutpass {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @db.Uuid
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reason       String
  fromDate     DateTime
  toDate       DateTime
  status       String            @default("Pending") // Pending, Approved, Rejected, Returned
  approvedById String?           @db.Uuid
  approvedBy   Staff?            @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  exitTime     DateTime?
  returnTime   DateTime?
  createdAt    DateTime          @default(now())

  @@map("hostel_outpasses")
}

