}

model MorningAssembly {
  id                  String   @id @default(uuid()) @db.Uuid
  date                DateTime
  campusId            String   @db.Uuid
  campus              Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  theme               String
  performingSectionId String   @db.Uuid
  performingSection   Section  @relation(fields: [performingSectionId], references: [id], onDelete: Cascade)
  supervisingStaffId  String   @db.Uuid
  supervisingStaff    Staff    @relation(fields: [supervisingStaffId], references: [id], onDelete: Restrict)
  venue               String
  activities          Json
