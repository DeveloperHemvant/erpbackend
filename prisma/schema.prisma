  userType        String
  reporterId      String   @db.Uuid
  title           String
  description     String
  assignedToId    String?  @db.Uuid
  assignedTo      Staff?   @relation(fields: [assignedToId], references: [id])
  escalationLevel Int      @default(0)
  status          String   @default("Open")
  createdAt       DateTime @default(now())
