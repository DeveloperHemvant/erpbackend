  type           String // Front Left, Front Right, Rear Left Outer, etc.
  installedDate  String // YYYY-MM-DD
  installedOdo   Float
  currentOdo     Float?
  treadDepth     Float? // In mm
  status         String           @default("In Use") // In Use, Retreaded, Scrapped
  warrantyExpiry String?
  createdAt      DateTime         @default(now())

  @@map("transport_tyres")
}

model TransportBattery {
  id             String           @id @default(uuid()) @db.Uuid
  vehicleId      String           @db.Uuid
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  batteryNumber  String           @unique
  brand          String?
  capacity       String? // e.g., 150Ah
  installedDate  String // YYYY-MM-DD
  status         String           @default("In Use") // In Use, Replaced, Dead
  warrantyExpiry String?
  createdAt      DateTime         @default(now())

  @@map("transport_batteries")
}

model TransportBreakdown {
  id             String           @id @default(uuid()) @db.Uuid
  vehicleId      String           @db.Uuid
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId       String?          @db.Uuid
  driver         Staff?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  date           String // YYYY-MM-DD
  time           String
  location       String?
  description    String
  actionTaken    String?
  towingRequired Boolean          @default(false)
  costIncurred   Float?
  status         String           @default("Reported") // Reported, Acknowledged, Under Repair, Resolved
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())

  @@map("transport_breakdowns")
}

model TransportAccident {
  id               String           @id @default(uuid()) @db.Uuid
  vehicleId        String           @db.Uuid
  vehicle          TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId         String?          @db.Uuid
  driver           Staff?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  date             String // YYYY-MM-DD
  time             String
  location         String
  severity         String // Minor, Major, Fatal
  description      String
  policeReport     Boolean          @default(false)
  firNumber        String?
  insuranceClaimed Boolean          @default(false)
  claimAmount      Float?
  status           String           @default("Under Investigation") // Under Investigation, Acknowledged, Closed
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  createdAt        DateTime         @default(now())

  @@map("transport_accidents")
}

model TransportExpense {
  id              String            @id @default(uuid()) @db.Uuid
  vehicleId       String?           @db.Uuid
  vehicle         TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  date            String // YYYY-MM-DD
  category        String // Fuel, Maintenance, Toll, Parking, Fine, Salary, Insurance, Taxes, Other
  amount          Float
  paymentMode     String // Cash, Card, UPI, Bank Transfer
  referenceNumber String?
  vendorId        String?           @db.Uuid
  vendor          TransportVendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  remarks         String?
  receiptUrl      String?
  status          String            @default("Pending") // Pending, Approved, Rejected
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())

  @@map("transport_expenses")
}

// ==========================================
// LEARNING MANAGEMENT SYSTEM (LMS)
// ==========================================

model LMSCourse {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  subjectId   String?  @db.Uuid
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classId     String?  @db.Uuid
  class       Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  status      String   @default("Draft") // Draft, Published, Archived
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  sections            LMSCourseSection[]
  curriculum          LMSCurriculum?
  LMSGradebook        LMSGradebook?
  LMSLiveClass        LMSLiveClass[]
  LMSDiscussionThread LMSDiscussionThread[]
  LMSCertificate      LMSCertificate[]

  @@map("lms_courses")
}

model LMSCourseSection {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @db.Uuid
  course    LMSCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId String?   @db.Uuid
  section   Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teacherId String?   @db.Uuid
  teacher   Staff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("Active")
  createdAt DateTime  @default(now())

  @@map("lms_course_sections")
}

model LMSCurriculum {
  id          String    @id @default(uuid()) @db.Uuid
  courseId    String    @unique @db.Uuid
  course      LMSCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  board       String? // CBSE, ICSE, Custom
  description String?
  createdAt   DateTime  @default(now())

  units LMSUnit[]

  @@map("lms_curriculum")
}

model LMSUnit {
  id           String        @id @default(uuid()) @db.Uuid
  curriculumId String        @db.Uuid
  curriculum   LMSCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title        String
  orderIndex   Int           @default(0)
  createdAt    DateTime      @default(now())

  chapters LMSChapter[]

  @@map("lms_units")
}

model LMSChapter {
  id               String   @id @default(uuid()) @db.Uuid
  unitId           String   @db.Uuid
  unit             LMSUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  learningOutcomes String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())

  topics LMSTopic[]

  @@map("lms_chapters")
}

model LMSTopic {
  id         String     @id @default(uuid()) @db.Uuid
  chapterId  String     @db.Uuid
  chapter    LMSChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int        @default(0)
  createdAt  DateTime   @default(now())

  lessons LMSLesson[]

  @@map("lms_topics")
}

model LMSLesson {
  id          String   @id @default(uuid()) @db.Uuid
  topicId     String   @db.Uuid
  topic       LMSTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  content     String? // HTML or Markdown content
  durationMin Int      @default(30)
  orderIndex  Int      @default(0)
  isDraft     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources     LMSContentResource[]
  LMSAssignment LMSAssignment[]
  LMSQuiz       LMSQuiz[]

  @@map("lms_lessons")
}

model LMSContentResource {
  id         String     @id @default(uuid()) @db.Uuid
  lessonId   String?    @db.Uuid
  lesson     LMSLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title      String
  type       String // PDF, VIDEO, SCORM, LINK, IMAGE
  url        String
  sizeBytes  Int?
  uploadedBy String?    @db.Uuid
  createdAt  DateTime   @default(now())

  @@map("lms_content_resources")
}

// ==========================================
// LMS PHASE 2: ASSESSMENT ENGINE
// ==========================================

model LMSAssignment {
  id          String     @id @default(uuid()) @db.Uuid
  lessonId    String?    @db.Uuid
  lesson      LMSLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime?
  maxScore    Float      @default(100.0)
  createdAt   DateTime   @default(now())

  // Added for Phase 2 "Homework" — assignments made directly to a class
  // section don't require first building out the Course/Curriculum/Unit/
  // Chapter/Topic/Lesson content hierarchy lessonId depends on; both are
  // valid, independent ways to scope an assignment (nullable, additive).
  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teacherId String?  @db.Uuid
  teacher   Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  submissions LMSSubmission[]
  rubrics     LMSRubric[]

  @@map("lms_assignments")
}

model LMSSubmission {
  id           String        @id @default(uuid()) @db.Uuid
  assignmentId String        @db.Uuid
  assignment   LMSAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String        @db.Uuid
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  score        Float?
  feedback     String?
  submittedAt  DateTime      @default(now())
  gradedAt     DateTime?

  @@map("lms_submissions")
}

model LMSRubric {
  id           String        @id @default(uuid()) @db.Uuid
  assignmentId String        @db.Uuid
  assignment   LMSAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria     String
  maxPoints    Float
  createdAt    DateTime      @default(now())

  @@map("lms_rubrics")
}

model LMSQuestionBank {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  subjectId   String?  @db.Uuid
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  questions LMSQuestion[]

  @@map("lms_question_banks")
}

model LMSQuestion {
  id             String          @id @default(uuid()) @db.Uuid
  questionBankId String          @db.Uuid
  questionBank   LMSQuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  type           String // MCQ, TRUE_FALSE, ESSAY
  text           String
  options        Json?           @db.JsonB // [{id, text, isCorrect}]
  explanation    String?
  difficulty     String          @default("MEDIUM")
  createdAt      DateTime        @default(now())

  @@map("lms_questions")
}

model LMSQuiz {
  id          String     @id @default(uuid()) @db.Uuid
  lessonId    String?    @db.Uuid
  lesson      LMSLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  description String?
  durationMin Int?
  maxScore    Float      @default(100.0)
  createdAt   DateTime   @default(now())

  attempts LMSQuizAttempt[]

  @@map("lms_quizzes")
}

model LMSQuizAttempt {
  id        String    @id @default(uuid()) @db.Uuid
  quizId    String    @db.Uuid
  quiz      LMSQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String    @db.Uuid
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Float?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  responses Json?     @db.JsonB // [{questionId, selectedOptionId}]

  @@map("lms_quiz_attempts")
}

model LMSGradebook {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @unique @db.Uuid
  course    LMSCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  grades LMSGrade[]

  @@map("lms_gradebooks")
}

model LMSGrade {
  id          String       @id @default(uuid()) @db.Uuid
  gradebookId String       @db.Uuid
  gradebook   LMSGradebook @relation(fields: [gradebookId], references: [id], onDelete: Cascade)
  studentId   String       @db.Uuid
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalScore  Float        @default(0.0)
  letterGrade String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("lms_grades")
}

// ==========================================
// LMS PHASE 3: LIVE CLASSES, SOCIAL, GAMIFICATION & AI
// ==========================================

model LMSLiveClass {
  id          String    @id @default(uuid()) @db.Uuid
  courseId    String    @db.Uuid
  course      LMSCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  meetingUrl  String
  scheduledAt DateTime
  durationMin Int       @default(60)
  hostId      String?   @db.Uuid
  host        Staff?    @relation(fields: [hostId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@map("lms_live_classes")
}

model LMSDiscussionThread {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @db.Uuid
  course    LMSCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  authorId  String?   @db.Uuid // UUID of Staff or Student
  createdAt DateTime  @default(now())

  posts LMSDiscussionPost[]

  @@map("lms_discussion_threads")
}

model LMSDiscussionPost {
  id        String              @id @default(uuid()) @db.Uuid
  threadId  String              @db.Uuid
  thread    LMSDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content   String
  authorId  String?             @db.Uuid
  createdAt DateTime            @default(now())

  @@map("lms_discussion_posts")
}

model LMSStudentPortfolio {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalXP   Int      @default(0)
  createdAt DateTime @default(now())

  badges       LMSBadge[]
  certificates LMSCertificate[]

  @@map("lms_student_portfolios")
}

model LMSBadge {
  id          String              @id @default(uuid()) @db.Uuid
  portfolioId String              @db.Uuid
  portfolio   LMSStudentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name        String
  iconUrl     String?
  earnedAt    DateTime            @default(now())

  @@map("lms_badges")
}

model LMSCertificate {
  id          String              @id @default(uuid()) @db.Uuid
  portfolioId String              @db.Uuid
  portfolio   LMSStudentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  courseId    String              @db.Uuid
  course      LMSCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issueDate   DateTime            @default(now())
  fileUrl     String?

  @@map("lms_certificates")
}

model LMSAIGeneration {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid // UUID of Staff generating it
  prompt    String
  result    String?
  type      String // LESSON_PLAN, QUIZ_GEN, STUDENT_TUTOR
  createdAt DateTime @default(now())

  @@map("lms_ai_generations")
}

// ==========================================
// EMS PHASE 1: FOUNDATION & OPERATIONS
// ==========================================

model EMSExamSession {
  id        String   @id @default(uuid()) @db.Uuid
  name      String // e.g. "Final Exams 2026-2027"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  schedules     EMSExamSchedule[]
  EMSGradebook  EMSGradebook[]
  EMSReportCard EMSReportCard[]

  @@map("ems_exam_sessions")
}

model EMSExamType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String // Unit Test, Mid Term, Final, Practical
  description String?
  createdAt   DateTime @default(now())

  templates EMSExamTemplate[]

  @@map("ems_exam_types")
}

model EMSExamTemplate {
  id         String      @id @default(uuid()) @db.Uuid
  typeId     String      @db.Uuid
  type       EMSExamType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name       String
  totalMarks Float
  passMarks  Float
  createdAt  DateTime    @default(now())

  schedules EMSExamSchedule[]

  @@map("ems_exam_templates")
}

model EMSExamSchedule {
  id         String          @id @default(uuid()) @db.Uuid
  sessionId  String          @db.Uuid
  session    EMSExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templateId String          @db.Uuid
  template   EMSExamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subjectId  String          @db.Uuid
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime        @default(now())

  mode              String                @default("OFFLINE") // OFFLINE | ONLINE
  durationMin       Int?
  questionPaperId   String?               @db.Uuid
  questionPaper     EMSQuestionPaper?     @relation(fields: [questionPaperId], references: [id], onDelete: SetNull)
  onlineSubmissions EMSOnlineSubmission[]

  rooms               EMSExamRoom[]
  EMSExamAttempt      EMSExamAttempt[]
  EMSModerationRecord EMSModerationRecord[]

  @@map("ems_exam_schedules")
}

model EMSExamRoom {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @db.Uuid
  schedule   EMSExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  roomId     String          @db.Uuid // UUID referencing a generic MasterData Room
  capacity   Int

  seatings     EMSExamSeating[]
  invigilators EMSInvigilator[]

  @@map("ems_exam_rooms")
}

model EMSExamSeating {
  id         String      @id @default(uuid()) @db.Uuid
  roomId     String      @db.Uuid
  room       EMSExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId  String      @db.Uuid
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seatNumber String

  @@map("ems_exam_seatings")
}

model EMSInvigilator {
  id      String      @id @default(uuid()) @db.Uuid
  roomId  String      @db.Uuid
  room    EMSExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  staffId String      @db.Uuid
  staff   Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("ems_invigilators")
}

model EMSQuestionBank {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  subjectId   String?  @db.Uuid
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  questions EMSQuestion[]

  @@map("ems_question_banks")
}

model EMSQuestion {
  id             String          @id @default(uuid()) @db.Uuid
  questionBankId String          @db.Uuid
  questionBank   EMSQuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  type           String // MCQ, DESCRIPTIVE, PRACTICAL
  text           String
  bloomLevel     String?
  difficulty     String          @default("MEDIUM")
  createdAt      DateTime        @default(now())

  options         Json?   @db.JsonB // [{id, text}], MCQ only
  correctOptionId String?
  marks           Float   @default(1)

  paperItems EMSQuestionPaperItem[]
  answers    EMSAnswer[]

  @@map("ems_questions")
}

model EMSQuestionPaper {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  subjectId   String   @db.Uuid
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  totalMarks  Float
  durationMin Int
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  items     EMSQuestionPaperItem[]
  schedules EMSExamSchedule[]

  @@map("ems_question_papers")
}

model EMSQuestionPaperItem {
  id              String           @id @default(uuid()) @db.Uuid
  questionPaperId String           @db.Uuid
  questionPaper   EMSQuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)
  questionId      String           @db.Uuid
  question        EMSQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sequence        Int
  marks           Float

  @@unique([questionPaperId, questionId])
  @@map("ems_question_paper_items")
}

// ==========================================
// EMS PHASE 2: EVALUATION & RESULT PROCESSING
// ==========================================

model EMSExamAttempt {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @db.Uuid
  schedule   EMSExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  String          @db.Uuid
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     String          @default("PRESENT") // PRESENT, ABSENT, MALPRACTICE
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime        @default(now())

  answerSheets     EMSAnswerSheet[]
  evaluations      EMSEvaluationRecord[]
  onlineSubmission EMSOnlineSubmission?

  @@map("ems_exam_attempts")
}

model EMSOnlineSubmission {
  id            String          @id @default(uuid()) @db.Uuid
  attemptId     String          @unique @db.Uuid
  attempt       EMSExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scheduleId    String          @db.Uuid
  schedule      EMSExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startedAt     DateTime?
  submittedAt   DateTime?
  autoSubmitted Boolean         @default(false)
  status        String          @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | GRADED
  createdAt     DateTime        @default(now())

  answers EMSAnswer[]

  @@map("ems_online_submissions")
}

model EMSAnswer {
  id               String              @id @default(uuid()) @db.Uuid
  submissionId     String              @db.Uuid
  submission       EMSOnlineSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId       String              @db.Uuid
  question         EMSQuestion         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  textAnswer       String?
  isCorrect        Boolean?
  marksAwarded     Float?
  answeredAt       DateTime            @updatedAt

  @@unique([submissionId, questionId])
  @@map("ems_answers")
}

model EMSAnswerSheet {
  id        String         @id @default(uuid()) @db.Uuid
  attemptId String         @db.Uuid
  attempt   EMSExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  fileUrl   String?
  content   String? // Digital text
  isGraded  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@map("ems_answer_sheets")
}

model EMSEvaluationRecord {
  id            String         @id @default(uuid()) @db.Uuid
  attemptId     String         @db.Uuid
  attempt       EMSExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evaluatorId   String         @db.Uuid
  evaluator     Staff          @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  marksObtained Float
  remarks       String?
  gradedAt      DateTime       @default(now())

  @@map("ems_evaluation_records")
}

model EMSModerationRecord {
  id          String          @id @default(uuid()) @db.Uuid
  scheduleId  String          @db.Uuid
  schedule    EMSExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  moderatorId String          @db.Uuid
  moderator   Staff           @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  graceMarks  Float
  reason      String
  approvedAt  DateTime        @default(now())

  @@map("ems_moderation_records")
}

model EMSGradingScheme {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ranges      Json     @db.JsonB // [{min: 90, max: 100, grade: "A+"}]
  createdAt   DateTime @default(now())

  @@map("ems_grading_schemes")
}

model EMSGradebook {
  id          String         @id @default(uuid()) @db.Uuid
  sessionId   String         @db.Uuid
  session     EMSExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classId     String         @db.Uuid
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  isPublished Boolean        @default(false)

  results EMSResult[]

  @@map("ems_gradebooks")
}

model EMSResult {
  id          String       @id @default(uuid()) @db.Uuid
  gradebookId String       @db.Uuid
  gradebook   EMSGradebook @relation(fields: [gradebookId], references: [id], onDelete: Cascade)
  studentId   String       @db.Uuid
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalMarks  Float
  percentage  Float
  grade       String?
  gpa         Float?
  rank        Int?
  createdAt   DateTime     @default(now())

  @@map("ems_results")
}

model EMSReportCard {
  id          String         @id @default(uuid()) @db.Uuid
  studentId   String         @db.Uuid
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId   String         @db.Uuid
  session     EMSExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileUrl     String?
  remarks     String?
  attendance  Float?
  publishedAt DateTime       @default(now())

  @@map("ems_report_cards")
}

model EMSCertificate {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String // MERIT, PARTICIPATION, COMPLETION
  title     String
  fileUrl   String?
  issueDate DateTime @default(now())

  @@map("ems_certificates")
}

// ==========================================
// ACMS PHASE 1: ACADEMIC CALENDAR & TERMS
// ==========================================

model ACMSAcademicTerm {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @db.Uuid
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String // e.g. "Term 1", "Semester 1"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime        @default(now())

  @@map("acms_academic_terms")
}

model ACMSHolidayMaster {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  date        DateTime
  type        String // NATIONAL, REGIONAL, SCHOOL
  description String?
  campusId    String?  @db.Uuid
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@map("acms_holiday_master")
}

model ACMSWorkingDay {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String          @db.Uuid
  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 1=Monday...7=Sunday
  isWorkingDay Boolean         @default(true)
  isHalfDay    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@map("acms_working_days")
}

// ==========================================
// ACMS PHASE 2: EVENTS & RESOURCES
// ==========================================

model ACMSEvent {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  campusId    String?         @db.Uuid
  campus      Campus?         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  type        String // ACADEMIC, SPORTS, CULTURAL, TRIP, COMPETITION, EXHIBITION, OLYMPIAD, SEMINAR, TOUR
  organizer   String?
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("acms_events")
}

model ACMSResourceBooking {
  id           String   @id @default(uuid()) @db.Uuid
  resourceName String // e.g. "Main Auditorium", "Chemistry Lab"
  bookedBy     String // Could be staff name or ID
  purpose      String
  startDate    DateTime
  endDate      DateTime
  status       String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  createdAt    DateTime @default(now())

  @@map("acms_resource_bookings")
}

// ==========================================
// ACMS PHASE 3: NOTIFICATIONS & AUDIT
// ==========================================

model ACMSNotification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String // Targeting a specific user (Staff/Student)
  title     String
  message   String
  type      String // EMAIL, SMS, PUSH
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@map("acms_notifications")
}

model ACMSAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  entityType  String
  entityId    String
  performedBy String
  timestamp   DateTime @default(now())
  details     String?

  @@map("acms_audit_logs")
}

// ==========================================
// SYSTEM AUDIT & MOBILE METADATA
// ==========================================

model SystemAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String // e.g. "MOBILE_LOGIN", "ATTENDANCE_MARKED"
  module      String // e.g. "AUTH", "TRANSPORT", "ATTENDANCE"
  entityType  String?
  entityId    String?
  performedBy String // user ID
  role        String // TEACHER, PARENT, DRIVER, CONDUCTOR
  details     Json?    @db.JsonB
  ipAddress   String?
  deviceInfo  String?
  timestamp   DateTime @default(now())

  @@map("system_audit_logs")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid // Staff.id, Parent.id, or Student.id depending on userType
  userType  String // "STAFF" | "PARENT" | "STUDENT"
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, userType])
  @@map("push_tokens")
}

// ==========================================
// HEALTH RECORDS
// ==========================================

model HealthProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  studentId             String   @unique @db.Uuid
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodGroup            String?
  allergies             String?
  chronicConditions     String?
  currentMedications    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  familyDoctorName      String?
  familyDoctorPhone     String?
  insuranceProvider     String?
  insurancePolicyNo     String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  visits       HealthVisit[]
  vaccinations Vaccination[]

  @@map("health_profiles")
}

model HealthVisit {
  id              String         @id @default(uuid()) @db.Uuid
  studentId       String         @db.Uuid
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  healthProfileId String?        @db.Uuid
  healthProfile   HealthProfile? @relation(fields: [healthProfileId], references: [id], onDelete: SetNull)
  visitDate       DateTime       @default(now())
  reason          String
  symptoms        String?
  temperature     Float?
  treatmentGiven  String?
  actionTaken     String         @default("Observed and Released") // Observed and Released, Sent Home, Referred to Doctor, Hospitalized
  parentNotified  Boolean        @default(false)
  loggedByStaffId String         @db.Uuid
  loggedByStaff   Staff          @relation(fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())

  @@map("health_visits")
}

model Vaccination {
  id               String         @id @default(uuid()) @db.Uuid
  studentId        String         @db.Uuid
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  healthProfileId  String?        @db.Uuid
  healthProfile    HealthProfile? @relation(fields: [healthProfileId], references: [id], onDelete: SetNull)
  vaccineName      String
  doseNumber       Int            @default(1)
  dateAdministered DateTime
  nextDueDate      DateTime?
  administeredBy   String?
  certificateUrl   String?
  createdAt        DateTime       @default(now())

  @@map("vaccinations")
}

// ==========================================
// DISCIPLINE / BEHAVIOR TRACKING
// ==========================================

model DisciplineIncident {
  id                String   @id @default(uuid()) @db.Uuid
  studentId         String   @db.Uuid
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  incidentDate      DateTime @default(now())
  category          String // Bullying, Disruption, Academic Dishonesty, Property Damage, Attendance, Other
  severity          String   @default("Minor") // Minor, Moderate, Major
  description       String
  actionTaken       String? // Verbal Warning, Written Warning, Detention, Suspension, Parent Meeting, Counseling Referral
  status            String   @default("Open") // Open, Resolved, Escalated
  reportedByStaffId String   @db.Uuid
  reportedByStaff   Staff    @relation("DisciplineReportedBy", fields: [reportedByStaffId], references: [id], onDelete: Restrict)
  parentNotified    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  counselingNotes DisciplineCounselingNote[]

  @@map("discipline_incidents")
}

model DisciplineCounselingNote {
  id               String             @id @default(uuid()) @db.Uuid
  incidentId       String             @db.Uuid
  incident         DisciplineIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  note             String
  createdByStaffId String             @db.Uuid
  createdByStaff   Staff              @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())

  @@map("discipline_counseling_notes")
}

// ==========================================
// ADMISSION INQUIRY / LEAD PIPELINE
// ==========================================

model AdmissionInquiry {
  id                 String   @id @default(uuid()) @db.Uuid
  childName          String
  gradeInterested    String
  parentName         String
  phone              String
  email              String?
  source             String   @default("Walk-in") // Walk-in, Website, Referral, Phone, Social Media, Other
  status             String   @default("New") // New, Contacted, Campus Visit Scheduled, Application Sent, Converted, Lost
  notes              String?
  assignedToStaffId  String?  @db.Uuid
  assignedToStaff    Staff?   @relation(fields: [assignedToStaffId], references: [id], onDelete: SetNull)
  convertedStudentId String?  @unique @db.Uuid
  convertedStudent   Student? @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  followUps AdmissionInquiryFollowUp[]

  @@map("admission_inquiries")
}

model AdmissionInquiryFollowUp {
  id               String           @id @default(uuid()) @db.Uuid
  inquiryId        String           @db.Uuid
  inquiry          AdmissionInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  note             String
  followUpDate     DateTime         @default(now())
  createdByStaffId String           @db.Uuid
  createdByStaff   Staff            @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())

  @@map("admission_inquiry_followups")
}

// ==========================================
// SHARED CROSS-CUTTING SERVICES (IA §16 #6/#7)
// Generic {entityType, entityId}-keyed stores, not owned by any one module —
// every current and future entity type shares these two tables.
// ==========================================

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  authorId   String   @db.Uuid
  author     Staff    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String
  entityId     String   @db.Uuid
  fileName     String
  sizeBytes    Int      @default(0)
  uploadedById String   @db.Uuid
  uploadedBy   Staff    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  url          String
  uploadedAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

// ==========================================
// WORKFLOW ENGINE + RULES ENGINE (IA §16 #4, Appendix A.2)
// Stage/transition and eligibility logic as data, evaluated by one engine —
// additive services; existing modules' inline transition/calculation logic
// is not migrated onto these in this pass (see docs/PHASE8_WORKFLOW_RULES_ENGINE.md).
// ==========================================

model WorkflowDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  name        String
  stages      Json     @db.JsonB
  transitions Json     @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, name])
  @@map("workflow_definitions")
}

model Rule {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  entityType  String
  description String
  definition  Json     @db.JsonB
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rules")
}

model VisitorRecord {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String
  phone            String
  purpose          String
  hostId           String?   @db.Uuid
  host             Staff?    @relation(fields: [hostId], references: [id])
  govIdType        String?
  govIdNumber      String?
  photoUrl         String?
  vehicleNumber    String?
  hostConfirmation String    @default("PENDING")
  blacklisted      Boolean   @default(false)
  entryTime        DateTime  @default(now())
  exitTime         DateTime?
  status           String    @default("CheckedIn")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("visitor_records")
}

model StudentGatePass {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @db.Uuid
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason       String
  leaveType    String
  approvedById String    @db.Uuid
  approvedBy   Staff     @relation(fields: [approvedById], references: [id])
  exitTime     DateTime  @default(now())
  returnTime   DateTime?
  status       String    @default("Approved")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("student_gate_passes")
}

// Added Phase 2 — Reception desk (SOR items 2.6/2.7). Neither existed in any
// form before (no model, no screen, no API) per the operational readiness audit.
model CourierLog {
  id          String   @id @default(uuid()) @db.Uuid
  type        String // INCOMING, OUTGOING
  sender      String?
  recipient   String?
  description String
  status      String   @default("Received") // Received, Dispatched, Collected
  loggedById  String?  @db.Uuid
  loggedBy    Staff?   @relation(fields: [loggedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@map("courier_logs")
}

model Appointment {
  id           String   @id @default(uuid()) @db.Uuid
  visitorName  String
  purpose      String
  scheduledFor DateTime
  hostId       String?  @db.Uuid
  host         Staff?   @relation(fields: [hostId], references: [id], onDelete: SetNull)
  status       String   @default("Scheduled") // Scheduled, Completed, Cancelled
  createdAt    DateTime @default(now())

  @@map("appointments")
}

// Added Phase 2 — internal meetings scheduling (SOR item 2.8). "Meetings"
// had zero implementation anywhere per the operational readiness audit.
model Meeting {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  agenda       String?
  scheduledFor DateTime
  location     String?
  status       String   @default("Scheduled") // Scheduled, Completed, Cancelled
  organizerId  String?  @db.Uuid
  organizer    Staff?   @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  attendeeIds  Json?    @db.JsonB // array of Staff ids
  createdAt    DateTime @default(now())

  @@map("meetings")
}

model SchoolHouse {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  captainId         String?  @db.Uuid
  captain           Student? @relation("HouseCaptain", fields: [captainId], references: [id])
  viceCaptainId     String?  @db.Uuid
  viceCaptain       Student? @relation("HouseViceCaptain", fields: [viceCaptainId], references: [id])
  teacherInchargeId String?  @db.Uuid
  teacherIncharge   Staff?   @relation(fields: [teacherInchargeId], references: [id])
  points            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members Student[] @relation("HouseMembers")

  @@map("school_houses")
}

model StaffDutyAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @db.Uuid
  staff     Staff    @relation(fields: [staffId], references: [id])
  dutyType  String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_duty_allocations")
}

model TeacherSubstitution {
  id                  String          @id @default(uuid()) @db.Uuid
  leaveApplicationId  String          @db.Uuid
  primaryTeacherId    String          @db.Uuid
  primaryTeacher      Staff           @relation("PrimaryTeacher", fields: [primaryTeacherId], references: [id])
  substituteTeacherId String          @db.Uuid
  substituteTeacher   Staff           @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  date                DateTime
  timetablePeriodId   String          @db.Uuid
